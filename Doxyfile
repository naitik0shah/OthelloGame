OUTPUT_DIRECTORY       = docs/doxygen

# --- Scope (For poorly documented codebases) ---
EXTRACT_ALL            = YES   # Documents everything even without existing comments
EXTRACT_STATIC         = NO    # Hides internal helper functions from global clutter
RECURSIVE              = YES
INPUT                  = src include README.md
USE_MDFILE_AS_MAINPAGE = README.md

# --- Graphviz / Dot Settings ---
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg   # Vector output (crisp at any zoom)
INTERACTIVE_SVG        = YES   # Adds pan/zoom controls directly in the HTML page

# --- Taming the "Zoo" ---
CALL_GRAPH             = YES   # Shows what a function calls
CALLER_GRAPH           = YES   # Shows what calls this function
MAX_DOT_GRAPH_DEPTH    = 2     # CRITICAL: Limits call chains to 2 hops (stops full-program hairballs)
DOT_GRAPH_MAX_NODES    = 25    # Truncates overly dense graphs instead of rendering giant maps
HIDE_UNDOC_RELATIONS   = YES   # Hides links to undocumented/trivial items
INCLUDE_GRAPH          = YES   # Shows #include hierarchy
INCLUDED_BY_GRAPH      = NO    # Usually redundant noise
DIRECTORY_GRAPH        = YES
UML_LOOK               = YES   # Cleaner, compact boxes for structs/classes

